# Secrets
.env

# Case data: source PDFs and fetched opinions (large, licensed, or both), plus
# every derivative artifact — OCR text, chunks, logs, batch state. All of it
# regenerates from the sources and the pipeline, so none of it belongs in git.
# One rule now that everything about a case lives under one directory.
data/cases/*
!data/cases/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Claude Code local state (settings.local.json etc.)
.claude/
.gstack/
